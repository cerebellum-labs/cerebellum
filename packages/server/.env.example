PORT=8080
DATABASE_URL=postgres://postgres@localhost:5432/postgres?sslmode=disable
# Unlocks changing devices in the dashboard.
ADMIN_PASSWORD=
# Signs the dashboard's admin cookie, at least 32 bytes: openssl rand -hex 32
SESSION_SECRET=
# The dashboard's origin when it runs on a host of its own; empty when it
# shares the API's origin, as behind Vite's proxy in development.
DASHBOARD_ORIGIN=
# The cloud model, OpenAI-compatible: Nebius Token Factory by default. Without
# the key the server runs, but /decide fails and nothing is reviewed.
NEBIUS_API_KEY=
# Defaults: Token Factory, Nemotron 3.5 Super VL and its price per million tokens.
NEBIUS_BASE_URL=
MODEL_ID=
MODEL_PRICE_INPUT_PER_M=
MODEL_PRICE_OUTPUT_PER_M=
