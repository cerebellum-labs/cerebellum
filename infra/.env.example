TUNNEL_TOKEN=
# Goes into the database URL, so keep it URL-safe: openssl rand -hex 32
POSTGRES_PASSWORD=
# Unlocks changing devices in the dashboard.
ADMIN_PASSWORD=
# Signs the dashboard's admin cookie, at least 32 bytes: openssl rand -hex 32
SESSION_SECRET=
# The dashboard's origin when it runs on a host of its own,
# e.g. https://demo.example.com; empty when it shares the API's origin.
DASHBOARD_ORIGIN=
# main or a release version, e.g. 0.1.0
SERVER_TAG=main
